[Unit]
Description=OpenGym Telegram Bot Daemon
Documentation=file:/opt/opengym/gym-coach-brain/README.md
After=network.target

[Service]
Type=simple
User=opengym
WorkingDirectory=/opt/opengym/gym-coach-brain

# The bot is the only chat-facing daemon. The backend API is called in-process via execute_intent().
ExecStart=/opt/opengym/gym-coach-brain/.venv/bin/python -m gym_coach_brain.bot.main

Restart=on-failure
RestartSec=5s
MemoryMax=2G
EnvironmentFile=/opt/opengym/gym-coach-brain/systemd/gym-coach-brain.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gym-coach-brain-bot

[Install]
WantedBy=multi-user.target
