# Copy this file to gym-coach-brain.env on the target host and keep the real file out of git.
DATABASE_URL=sqlite:////opt/opengym/gym-coach-brain/gym_coach.sqlite
MODEL_DIR=/opt/opengym/model_weights
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o
ML_POLL_INTERVAL=60
ML_FINE_TUNE_THRESHOLD=5
